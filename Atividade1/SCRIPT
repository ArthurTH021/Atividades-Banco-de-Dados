-- 1. EMPRESA
CREATE TABLE EMPRESA (
    CD_EMPRESA SERIAL PRIMARY KEY,
    DS_EMPRESA VARCHAR(100) NOT NULL,
    NM_FANTASIA_EMPRESA VARCHAR(100) NOT NULL
);

-- 2. FILIAL
CREATE TABLE FILIAL (
    CD_FILIAL SERIAL PRIMARY KEY,
    DS_FILIAL VARCHAR(100) NOT NULL,
    NM_FANTASIA_FILIAL VARCHAR(100) NOT NULL,
    NR_CNPJ_FILIAL VARCHAR(14) NOT NULL,
    CD_EMPRESA INT NOT NULL,

    CONSTRAINT FK_CD_EMPRESA FOREIGN KEY (CD_EMPRESA) 
        REFERENCES EMPRESA (CD_EMPRESA)
);

-- 3. GRUPO DE PRODUTOS
CREATE TABLE GRUPO_PRODUTO (
    CD_GRUPO_PRODUTO SERIAL PRIMARY KEY,
    DS_GRUPO_PRODUTO VARCHAR(80) NOT NULL
);

-- 4. PRODUTO
CREATE TABLE PRODUTO (
    CD_PRODUTO SERIAL PRIMARY KEY,
    DS_PRODUTO VARCHAR(100) NOT NULL,
    DS_MARCA_PRODUTO VARCHAR(50) NOT NULL,
    DS_MODELO_PRODUTO VARCHAR(20) NOT NULL,
    DT_CADASTRO_PRODUTO DATE NOT NULL,
    ST_PRODUTO CHAR(1) NOT NULL,
    CD_GRUPO_PRODUTO INT NOT NULL,

    CONSTRAINT FK_CD_GRUPO_PRODUTO FOREIGN KEY (CD_GRUPO_PRODUTO) 
        REFERENCES GRUPO_PRODUTO (CD_GRUPO_PRODUTO)
);

-- 5. ESTOQUE (Associa Produto a uma Filial)
CREATE TABLE ESTOQUE (
    CD_ESTOQUE SERIAL PRIMARY KEY,
    SALDO_ESTOQUE NUMERIC(10,2) NOT NULL,
    VLR_CUSTO_UNITARIO NUMERIC(10,2),
    VLR_PRECO_VENDA NUMERIC(10,2),
    CD_FILIAL INT NOT NULL,
    CD_PRODUTO INT NOT NULL,

    CONSTRAINT FK_CD_FILIAL FOREIGN KEY (CD_FILIAL) 
        REFERENCES FILIAL (CD_FILIAL),
    CONSTRAINT FK_CD_PRODUTO_ESTOQUE FOREIGN KEY (CD_PRODUTO) 
        REFERENCES PRODUTO (CD_PRODUTO)
);

-- 6. CLIENTE
CREATE TABLE CLIENTE (
    CD_CLIENTE SERIAL PRIMARY KEY,
    NM_CLIENTE VARCHAR(100) NOT NULL,
    NR_CPF_CNPJ VARCHAR(14) NOT NULL,
    DS_EMAIL VARCHAR(100),
    NR_TELEFONE VARCHAR(20)
);

-- 7. PEDIDO / VENDA (Cabeçalho da transação)
CREATE TABLE PEDIDO (
    CD_PEDIDO SERIAL PRIMARY KEY,
    DT_PEDIDO DATE NOT NULL,
    VLR_TOTAL NUMERIC(10,2) NOT NULL,
    ST_PEDIDO CHAR(1) NOT NULL,
    CD_FILIAL INT NOT NULL,
    CD_CLIENTE INT NOT NULL,

    CONSTRAINT FK_CD_FILIAL_PEDIDO FOREIGN KEY (CD_FILIAL) 
        REFERENCES FILIAL (CD_FILIAL),
    CONSTRAINT FK_CD_CLIENTE FOREIGN KEY (CD_CLIENTE) 
        REFERENCES CLIENTE (CD_CLIENTE)
);

-- 8. ITEM DO PEDIDO (Detalhamento dos produtos vendidos)
CREATE TABLE ITEM_PEDIDO (
    CD_ITEM_PEDIDO SERIAL PRIMARY KEY,
    QT_PRODUTO NUMERIC(10,2) NOT NULL,
    VLR_UNITARIO NUMERIC(10,2) NOT NULL,
    VLR_TOTAL_ITEM NUMERIC(10,2) NOT NULL,
    CD_PEDIDO INT NOT NULL,
    CD_PRODUTO INT NOT NULL,

    CONSTRAINT FK_CD_PEDIDO FOREIGN KEY (CD_PEDIDO) 
        REFERENCES PEDIDO (CD_PEDIDO),
    CONSTRAINT FK_CD_PRODUTO_ITEM FOREIGN KEY (CD_PRODUTO) 
        REFERENCES PRODUTO (CD_PRODUTO)
);
